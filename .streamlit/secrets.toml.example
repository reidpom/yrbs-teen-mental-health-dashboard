# Copy to .streamlit/secrets.toml (local) or paste into the app's Secrets on Streamlit Community Cloud.
# Never commit the real file.
ANTHROPIC_API_KEY = "sk-ant-..."
# Optional:
APP_PASSWORD = "pick-a-team-password"     # leave out to let anyone use the assistant
MAX_QUESTIONS_PER_VISITOR = 15
# CLAUDE_MODEL = "claude-opus-5-5"         # default; claude-sonnet-5-5 or claude-haiku-5-5 cost less
